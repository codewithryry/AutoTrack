# Optional: restrict public sign-up to institutional email addresses.
# Comma-separated bare domains; subdomains are accepted. Leave empty to allow any
# address. This check runs in the browser only.
# VITE_SIGNUP_EMAIL_DOMAINS=autolab.edu.ph,minsu.edu.ph
VITE_SIGNUP_EMAIL_DOMAINS=

# --- Supabase --------------------------------------------------------------
# The publishable (anon) key is public by design: it identifies the project and
# authorises nothing on its own. Row Level Security is what protects the data.
# The service-role key must NEVER appear here or in any VITE_ variable — it
# bypasses RLS and would ship to every browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Text generation (Cohere) ----------------------------------------------
# The assistant's tooltip lines are written in the source and shown as they are.
# When a Cohere key is configured, `api/assistant.js` rewords the line it is
# given before the tooltip shows it; without one, the endpoint answers 503 and
# every screen keeps its written line. Offline, nothing is requested at all.
#
# This variable has NO VITE_ prefix, deliberately, and belongs only in the
# server environment — set it in the Vercel project settings, never in a
# committed file. A VITE_ prefix would ship the key to every browser, and any
# value written into this repository is a value the public can read. Leave the
# line below empty here; it documents the name, not the secret.
COHERE_API_KEY=


# --- Web Push ---------------------------------------------------------------
# Generate the pair with `npx web-push generate-vapid-keys`.
#
# Only the PUBLIC half carries a VITE_ prefix: it is the application server key
# the browser needs in order to subscribe, and it is public by design. The
# private key and the subject are server-only — a VITE_ prefix on either would
# ship them to every browser and let anyone push to your users. Set them in the
# Vercel project settings, never in a committed file.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
