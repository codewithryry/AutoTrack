# Environment for ToolTrack AutoLab.
#
# The file is split by trust boundary, and the boundary is the `VITE_` prefix:
#
#   • VITE_* is COMPILED INTO THE BUNDLE. It ships to every browser and is
#     packed into the Android APK, which anyone can unzip. Nothing secret may
#     ever carry this prefix.
#   • everything else is SERVER-ONLY. It is read by `api/*` on the deployment
#     (Vercel project settings), never by `src/`, and never by the Android build.
#
# Copy to `.env` and fill in. `.env` is gitignored and must stay that way.


# ---------------------------------------------------------------------------
# Client (VITE_*) — public by definition
# ---------------------------------------------------------------------------

# --- Supabase — REQUIRED ---------------------------------------------------
# `src/supabase/config.js` throws on start-up without these two.
#
# The publishable (anon) key is public by design: it identifies the project and
# authorises nothing on its own. Row Level Security is what protects the data.
# The service-role key must NEVER appear here or in any VITE_ variable — it
# bypasses RLS and would ship to every browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Web Push (public half) — optional -------------------------------------
# The application server key the browser needs in order to subscribe, read by
# `src/services/push.js`. Public by design. Left empty, `isAvailable()` is false
# and the app runs without push notifications — nothing else changes.
#
# Generate the pair with `npx web-push generate-vapid-keys`. Only the public
# half belongs here; the private half is server-only, below.
VITE_VAPID_PUBLIC_KEY=

# --- Sign-up allowlist — optional ------------------------------------------
# Restrict public sign-up to institutional email addresses. Comma-separated bare
# domains; subdomains are accepted. Read by `src/services/users.js`.
#
# Empty — the value this project runs with — means any address may register,
# which is what a public sign-up form is. A student account is the least
# privileged role in the system. This check runs in the browser only.
# Example: VITE_SIGNUP_EMAIL_DOMAINS=autolab.edu.ph,minsu.edu.ph
VITE_SIGNUP_EMAIL_DOMAINS=

# --- Deployment address — required for the ANDROID build only --------------
# Where the deployed web app lives, e.g. https://autotracking.vercel.app
#
# Read by `src/utils/native.js`. Inside the Android WebView the page is served
# from the shell's own `https://localhost`, so a relative `/api/...` resolves to
# nothing — this names the origin that can actually serve those endpoints, and
# the address the "install the app" card shares.
#
# Leave empty for web development: the app's own origin is used, exactly as
# before. The Android workflow sets it at build time. Not a secret.
VITE_PUBLIC_APP_URL=


# ---------------------------------------------------------------------------
# Server-only — NEVER given a VITE_ prefix, never in the Android build
# ---------------------------------------------------------------------------
# Set these in the Vercel project settings, not in a committed file. A VITE_
# prefix on any of them would ship the secret to every browser and into the APK.

# --- Supabase service role — used by `api/push.js` -------------------------
# Bypasses Row Level Security, so it is the most dangerous value in the project.
# It reads the notification row and decides who the push is for — something the
# browser is deliberately not allowed to do.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (private half) — used by `api/push.js` -----------------------
# The other half of the VAPID pair above. Anyone holding it can push to your
# users. `VAPID_SUBJECT` is the contact URL or mailto: the push service requires.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Text generation — used by `api/assistant.js` --------------------------
# The assistant's tooltip lines are written in the source and shown as they are.
# With a Cohere key configured, the endpoint rewords the line it is given before
# the tooltip shows it; without one it answers 503 and every screen keeps its
# written line. Offline, nothing is requested at all — so leaving this empty is
# a supported way to run the app.
COHERE_API_KEY=
