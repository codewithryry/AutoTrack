node_modules/
dist/

# Environment / secrets
.env
.env.local
.env.*.local
.env.example
.env.bak.1786848346

# Never commit service-account or admin credentials of any kind. Everything
# under src/ is shipped to the browser; a key that reaches this repository is a
# key that reaches every visitor.
*serviceAccount*.json
*service-account*.json
*-adminsdk-*.json
*.pem
.runtimeconfig.json

# Next.js artifacts (this is a Vite app — these come from running Next by mistake)
.next/
.vercel/
dist-ssr/
.vite/
*.local

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Android / Capacitor ----------------------------------------------------
# Signing material never belongs in the repository. CI decodes the keystore from
# a secret at build time and deletes it again; nothing below is ever committed.
*.jks
*.keystore
android/keystore.properties
android/key.properties

# Build output and local tooling state. The `android/` project itself IS
# committed — GitHub Actions builds from it — but everything Gradle generates is
# not.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/capacitor-cordova-android-plugins/
